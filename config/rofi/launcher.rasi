@import "theme.rasi"

configuration { modi: "drun,run,window"; show-icons: true; display-drun: "Aplicaciones"; drun-display-format: "{name}"; }
window { width: 42%; border: 2px; border-radius: 14px; padding: 16px; }
inputbar { children: [ prompt, entry ]; spacing: 10px; }
listview { columns: 1; lines: 9; spacing: 5px; }
element { padding: 8px; border-radius: 8px; }
element-icon { size: 24px; }

