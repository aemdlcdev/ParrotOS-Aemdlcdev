# Aplicaciones
super + Return
  kitty

super + space
  rofi -show drun -theme ~/.config/aemdlc-environment/rofi/launcher.rasi

super + shift + s
  flameshot gui

super + shift + x
  i3lock -c 10141f

super + shift + p
  ~/.local/share/aemdlc-environment/bin/power-menu

# Sesión y ventanas
super + shift + {q,r}
  bspc {quit,wm -r}

super + {q,shift + q}
  bspc node -{c,k}

super + shift + m
  bspc desktop -l next

super + {t,shift + t,f}
  bspc node -t {tiled,floating,fullscreen}

super + ctrl + {m,s,p}
  bspc node -g {marked,sticky,private}

# Foco e intercambio
super + {h,j,k,l}
  bspc node -f {west,south,north,east}

super + shift + {h,j,k,l}
  bspc node -s {west,south,north,east}

super + {bracketleft,bracketright}
  bspc desktop -f {prev,next}.local

super + Tab
  bspc desktop -f last

# Escritorios
super + {1-9,0}
  bspc desktop -f '^{1-9,10}'

super + shift + {1-9,0}
  bspc node -d '^{1-9,10}' --follow

# Preselección
super + ctrl + alt + {h,j,k,l}
  bspc node -p {west,south,north,east}

super + ctrl + alt + {1-9}
  bspc node -o 0.{1-9}

super + ctrl + alt + space
  bspc node -p cancel

# Movimiento y tamaño
super + alt + {h,j,k,l}
  ~/.local/share/aemdlc-environment/bin/resize-window {west,south,north,east}

super + alt + shift + {h,j,k,l}
  bspc node -v {-24 0,0 24,0 -24,24 0}

# Recargar atajos
super + Escape
  pkill -USR1 -x sxhkd

